    function calculateResult() {
      document.getElementById("progress-fill").style.width = "100%";

      const sortedCats = topCategories();
      const mainCat = sortedCats[0];
      const secondCat = sortedCats[1];
      const maxCatScore = Math.max(...Object.values(categoryScores), 1);
      const seed = `${userData.zodiac}-${userData.mbti}-${userData.blood}-${userData.bazi}`;
