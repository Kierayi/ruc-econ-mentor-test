          const randomMod = Math.abs(seedHash ^ teacherHash) % 15;
          const secondBonus = cat === secondCat ? 7 : 0;
          const mainBonus = cat === mainCat ? 9 : 0;
          let percentage = Math.floor((catPoints / maxCatScore) * 67) + randomMod + 12 + secondBonus + mainBonus;

          if (cat === mainCat && percentage < 86) percentage = 86 + (randomMod % 7);
          if (percentage > 99) percentage = 99;

          allTeacherScores.push({
            teacher: t,
            category: cat,
            percentage
          });
        });
      });

      allTeacherScores.sort((a, b) => {
        if (b.percentage !== a.percentage) return b.percentage - a.percentage;
        return a.teacher.name.localeCompare(b.teacher.name, "zh-Hans-CN");
      });

